          "end": 67
        }
      ],
      "status": "complete"
    },
    {
      "id": "block-010",
      "kind": "list",
      "source_line": 30,
      "original_text": "Opus 5.5：输入每百万 Token 4 美元，输出每百万 Token 20 美元；",
      "ranges": [
        {
          "slide": 3,
          "start": 0,
          "end": 44
        }
      ],
      "status": "complete"
    },
    {
      "id": "block-011",
