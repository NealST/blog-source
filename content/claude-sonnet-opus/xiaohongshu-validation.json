        {
          "id": "block-019",
          "start": 0,
          "end": 28,
          "text": "Sonnet 5.5 与 Opus 5.5 选型核心差异"
        }
      ]
    },
    {
      "slide": "slide-10",
      "imageOnly": true,
      "width": 540,
      "height": 317.84375,
      "used": 317.84375,
